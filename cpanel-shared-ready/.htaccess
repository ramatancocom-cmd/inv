# cPanel Shared Hosting Configuration for Mohamed & Rawan Invitation
RewriteEngine On
RewriteBase /

# 1. API routes routing to PHP backend scripts
RewriteRule ^api/rsvp/?$ api/rsvp.php [L,QSA]
RewriteRule ^api/rsvp/admin/?$ api/rsvp-admin.php [L,QSA]
RewriteRule ^api/wishes/?$ api/wishes.php [L,QSA]
RewriteRule ^api/wishes/admin/?$ api/wishes-admin.php [L,QSA]

# 2. Block direct browser access to data files for privacy
RewriteRule ^data(/.*)?$ - [F,L]

# 3. Clean URLs for HTML pages (/admin -> admin.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 4. Default directory index
DirectoryIndex index.html index.php

# 5. Enable gzip compression for fast loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# 6. Browser caching headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
